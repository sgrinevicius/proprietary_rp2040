# Arquivo: /nuttxspace_rp2040/apps/external/Raspberry/pico_w/bmp280/Kconfig
#
# SPDX-License-Identifier: Apache-2.0
#
# FILOSOFIA E PAPEL ESTRUTURAL NA ARQUITETURA DE APLICATIVOS EXTERNOS:
#
# Este arquivo define as opcoes de configuracao do aplicativo 'bmp280'.
# A flag principal CONFIG_PROPRIETARY_BMP280 controla a compilacao e
# inclusao do aplicativo no firmware.
#
# FUNCIONAMENTO DO MECANISMO DE CONFIGURACAO:
#
# - Quando a flag principal e ativada, os parametros adicionais (PROGNAME,
#   PRIORITY, STACKSIZE) tornam-se visiveis e editaveis no menuconfig.
# - O Makefile do aplicativo utiliza esses valores para registrar o programa
#   no NSH e definir o comportamento de execucao.
#
# ESTRATEGIA DE RESOLUCAO DE CAMINHOS:
#
# - Este arquivo e referenciado pelo Kconfig mestre em
#   'apps/external/esp32-s3/apps/Kconfig' pela linha:
#   source "$APPSDIR/eexternal/Raspberry/pico_w/bmp280/Kconfig"
#
########################################################################################################################

# Flag principal: ativa/desativa o aplicativo
config PROPRIETARY_BMP280

    # Tipo booleano (aparece como caixa de seleção)
    bool "Leitura do BMP280 via 'read()'"

    # Valor padrão: desabilitado
    default y

    # Dependência do driver BMP280
    depends on SENSORS_BMP280

    # Dependência de habilitação de sensores
    depends on SENSORS

    # Ajuda descritiva
    ---help---
        Enable the BMP280 read app (Phase 1)

if PROPRIETARY_BMP280

config PROPRIETARY_BMP280_PROGNAME
    string "Program name"
    default "bmp280"
    ---help---
        This is the name of the program that will be used when the NSH ELF
        program is installed.

config PROPRIETARY_BMP280_PRIORITY
    int "BMP280 task priority"
    default 100

config PROPRIETARY_BMP280_STACKSIZE
    int "BMP280 stack size"
    default DEFAULT_TASK_STACKSIZE

endif

########################################################################################################################
# Fim do arquivo 'Kconfig'
########################################################################################################################
