# SPDX-License-Identifier: Apache-2.0
#
# FILOSOFIA E PAPEL ESTRUTURAL NA ARQUITETURA DE APLICATIVOS EXTERNOS:
#
# Este arquivo define a flag de ativacao do aplicativo 'hello_world' no
# sistema de configuracao Kconfig do NuttX.
#
# A flag CONFIG_PROPRIETARY_HELLO_WORLD controla se o aplicativo sera
# compilado e incluido no firmware.
#
# PAPEL DO APLICATIVO 'HELLO_WORLD':
#
# - Atua como um teste de sanidade do ambiente de desenvolvimento.
# - Verifica se o sistema de build (GNU Make) esta funcionando
#   corretamente e se o aplicativo foi vinculado ao kernel.
# - Exibe uma mensagem simples no console serial ao ser executado.
#
########################################################################################################################

# Definicao da flag de ativacao do aplicativo
config PROPRIETARY_HELLO_WORLD

    # Tipo da opcao: booleana
    bool "Teste de Sanidade ('Hello World')"

    # Valor padrao: ativado
    default y

    # Ajuda descritiva
    ---help---
        Habilita a compilacao do aplicativo 'hello_world'.

        Este aplicativo exibe uma mensagem de sanidade no console serial,
        validando o fluxo de build e a vinculacao ao kernel.

        Nao possui dependencias adicionais - utiliza apenas 'printf()'.

########################################################################################################################
# Fim do arquivo 'Kconfig'
########################################################################################################################
